# .streamlit/secrets.toml.example
#
# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit secrets.toml to version control.
#
# Supabase credentials — find these in your Supabase project under:
#   Project Settings → API → Project URL  and  anon / public key
SUPABASE_URL = "https://<your-project-id>.supabase.co"
SUPABASE_KEY = "<your-anon-or-service-role-key>"

# Password for the admin dashboard (/Admin page)
ADMIN_PASSWORD = "changeme_before_use"
